@prefix ex: <http://example.org/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
ex:Researcher a owl:Class ;
  rdfs:label "Investigador"@es ;
  rdfs:subClassOf ex:Person , [
    a owl:Restriction ;
    owl:onProperty ex:worksAt ;
    owl:someValuesFrom ex:Org ] .
ex:Person a owl:Class ; rdfs:label "Persona"@es .
ex:alice a ex:Researcher ; ex:age 42 ;
  ex:colleagues ( ex:bob ex:carol ) .
