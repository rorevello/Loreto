# Copy to .env and edit. docker compose reads it automatically.

# 127.0.0.1: this machine only. 0.0.0.0: every network interface (e.g. a demo booth).
LORETO_DEMO_BIND=127.0.0.1
LORETO_DEMO_PORT=8000

# Fetch RDF from URLs typed by the user (only public addresses).
LORETO_DEMO_ALLOW_URL=true

LORETO_DEMO_MAX_INPUT_BYTES=10485760
LORETO_DEMO_MAX_TRIPLES=100000
WEB_CONCURRENCY=1
